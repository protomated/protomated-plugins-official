# Kit (ConvertKit) — free Newsletter plan, up to 10,000 subscribers
# https://kit.com → Account Settings → Developer → API Keys
KIT_API_KEY=your_kit_api_key_here

# The numeric ID of your Kit form
# Found in Kit → Forms → [your form] → Settings → Embed
KIT_FORM_ID=your_kit_form_id_here

# Download URL returned after email capture.
# Default: site-hosted file (site/public/downloads/solo-attorney-starter-kit.zip),
# which `npm run build` copies into place. Switch to a versioned GitHub
# Releases URL if you prefer to serve from releases.
PUBLIC_DOWNLOAD_URL=/downloads/solo-attorney-starter-kit.zip
